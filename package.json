{
  "name": "forecastlab",
  "version": "7.2.0",
  "description": "A local-first forecasting workbench: import time-series CSV data, check quality, compare explainable forecasting methods, and publish reproducible reports. Zero runtime dependencies; the browser workbench loads D3 from a CDN.",
  "type": "module",
  "bin": {
    "forecastlab": "src/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./series.js": "./src/series.js",
    "./models.js": "./src/models.js",
    "./evaluate.js": "./src/evaluate.js",
    "./report.js": "./src/report.js",
    "./project.js": "./src/project.js",
    "./multiSeries.js": "./src/multiSeries.js",
    "./uncertainty.js": "./src/uncertainty.js",
    "./counterfactual.js": "./src/counterfactual.js",
    "./scheduler.js": "./src/scheduler.js",
    "./causal.js": "./src/causal.js",
    "./streaming": "./src/streaming/index.js",
    "./visualizations": "./src/visualizations/index.js",
    "./workers": "./src/workers/index.js",
    "./scenarios": "./src/scenarios-index.js"
  },
  "files": [
    "src",
    "sdk",
    "examples",
    "docs",
    "test"
  ],
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\" \"test/streaming/**/*.test.js\" \"sdk/test/*.mjs\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:streaming": "node --test \"test/streaming/**/*.test.js\"",
    "test:sdk": "node --test \"sdk/test/*.mjs\"",
    "examples": "node scripts/make-examples.mjs",
    "demo": "node src/cli.js demo --example energy",
    "phase4:docs": "echo 'Generate tutorial notebooks from docs/tutorial/'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "keywords": [
    "forecasting",
    "time-series",
    "statistics",
    "hierarchical",
    "reconciliation",
    "VAR",
    "factor-models",
    "uncertainty",
    "scenario-planning",
    "counterfactual",
    "monte-carlo",
    "visualization",
    "browser-based"
  ],
  "license": "MIT"
}
